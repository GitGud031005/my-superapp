# Local Google OAuth credentials. Copy to .env (gitignored): Copy-Item .env.example .env
# Create the client in Google Cloud Console (type: Web application); see README "Google login".
# Keep both values non-empty: an empty value stops Spring from starting.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Comma-separated Google emails that administer the ledger (case-insensitive, must be verified by Google). Put your own address here.
LEDGER_ADMIN_EMAILS=admin@example.com
