# Local-only minikube credentials. Copy to secrets.env (gitignored): cp secrets.env.example secrets.env
# Never reuse these values anywhere that is reachable from outside your machine.
username=superapp
password=superapp
# Optional: Google OAuth client for sign-in. Keep the value non-empty; "not-configured" starts the app but sign-in fails at Google.
google-client-id=not-configured
google-client-secret=not-configured
# Comma-separated Google emails that administer the ledger. Empty means nobody is admin.
ledger-admin-emails=admin@example.com
